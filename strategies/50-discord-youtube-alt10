NFQWS_DSCYT_PORTS_UDP="${NFQWS_DSCYT_PORTS_UDP:-443,19294-19344,50000-50100}"
NFQWS_DSCYT_TCP_PKT_OUT="${NFQWS_DSCYT_TCP_PKT_OUT:-${NFQWS2_TCP_PKT_OUT:-$NFQWS_TCP_PKT_OUT}}"
NFQWS_DSCYT_TCP_PKT_IN="${NFQWS_DSCYT_TCP_PKT_IN:-${NFQWS2_TCP_PKT_IN:-$NFQWS_TCP_PKT_IN}}"
NFQWS_DSCYT_UDP_PKT_OUT="${NFQWS_DSCYT_UDP_PKT_OUT:-${NFQWS2_UDP_PKT_OUT:-$NFQWS_UDP_PKT_OUT}}"
NFQWS_DSCYT_UDP_PKT_IN="${NFQWS_DSCYT_UDP_PKT_IN:-0}"

